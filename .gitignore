target/
target_ci/
bin/
obj/
venv/
.venv/
env/
*.tmp
*.log

# Python
__pycache__/
*.pyc

# transcribe.py: outputs, local tool config, and per-tool venvs (external prerequisites)
transcriptions/
transcribe.local.json
# Ignore tools/ CONTENTS (not the dir itself — a `tools/` rule excludes the directory
# outright and git then cannot re-include anything inside it). This catches the transcribe
# venvs while letting committed dev tools below be re-included.
tools/*
# ...committed dev tools under tools/ ARE source (sample generator, render-diff harness).
!tools/ferrosintesis-samples/
!tools/render-diff/
# GM0 alternate-bank audition harness (torture-MIDI + CC0 injector + render driver).
!tools/gm0-audition/
# ...but its rendered WAVs are build output, not source.
tools/gm0-audition/renders/
# Rendered audio — reproducible build output, not source.
# Regenerate with `cargo run --release -p render-catalog`.
*.wav
*.opus
# ...but the synth's attack-transient sample banks are source, not output
!crates/ferrosintesis-samples-clavinet/samples/*.wav
!crates/ferrosintesis-samples-core/samples/*.wav
!crates/ferrosintesis-samples-drumkit/samples/*.wav
!crates/ferrosintesis-samples-orchestral/samples/*.wav
!crates/ferrosintesis-samples-orchestral2/samples/*.wav
!crates/ferrosintesis-samples-musescore/samples/*.wav
!crates/ferrosintesis-samples-gong/samples/*.wav
!crates/ferrosintesis-samples-grand/samples/*.wav
!crates/ferrosintesis-samples-vcsl-steinway/samples/*.wav
!crates/ferrosintesis-samples-vcsl-kawai/samples/*.wav
!crates/ferrosintesis-samples-headroom/samples/*.wav
!crates/ferrosintesis-samples-musescore-grand/samples/*.wav
!crates/ferrosintesis-samples-dark-salamander/samples/*.wav
!crates/ferrosintesis-samples-ydp-grand/samples/*.wav
!crates/ferrosintesis-samples-honkytonk/samples/*.wav
!crates/ferrosintesis-samples-sax/samples/*.wav
# ...and the un-re-fetchable CC BY 3.0 gong source WAVs (Freesound needs a login;
# committed so the processed bank is offline-reproducible via prepare.py).
!tools/ferrosintesis-samples/gong-src/*.wav

# Third-party reference MIDI test corpus (fan transcriptions of copyrighted works,
# used only to stress-test ferrosintesis against real-world MIDI content). Never
# commit or push these — this repo's remote is public. Local-only.
test-corpus/*
!test-corpus/README.md
